{
  "name": "ts-browser-ext",
  "private": true,
  "version": "1.1.0",
  "description": "Experimental Tailscale browser extension using tsnet and Native Messaging.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "sign:firefox": "web-ext sign --source-dir .output/firefox-mv3 --artifacts-dir .output/signed --channel unlisted",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
